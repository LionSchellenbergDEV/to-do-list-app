<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
    <link rel="stylesheet" href="style.css">
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <title>To-Do-List-App</title>
</head>
<body>
    <nav>
        <strong>To-Do-List-App</strong>
    </nav>
<main>
    <div id="create-task-wrapper">
        <h4>Create Task</h4>
        <form action="/create-task" method="post">
            <input type="text" class="form-control" name="title" id="title" placeholder="Title"  aria-describedby="addon-wrapping">
            <textarea type="text" class="form-control" name="description" id="description" placeholder="Description" rows="4" aria-describedby="addon-wrapping"></textarea>
            <input type="datetime-local" name="deadline" id="deadline">
            <input type="submit" class="btn btn-primary" value="Create Task">
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            Open Tasks
        </div>
        <div class="card-body">
        <% if (tasks.length === 0) { %>
            <div class="alert alert-info">No open tasks.</div>
        <% } else { %>
            <div class="list-group">
                <% tasks.forEach(task => { %>
                    <% if (!task.done) { %>
                        <div class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="ms-2 me-auto">
                                <div class="fw-bold"><%= task.title %></div>
                                <small><%= task.description %></small><br>
                                <% if (task.deadline) { %>
                                    <small class="text-muted">Due: <%= task.deadline.toISOString().split('T')[0] %></small>
                                <% } %>
                            </div>
                            <div class="btn-group">
                                <form action="/delete-task/<%= task.id %>" method="POST" class="me-1">
                                    <button type="submit" class="btn btn-light">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% } %>
                <% }); %>
            </div>
        <% } %>
        </div>
    </div>
</main>
</body>
</html>